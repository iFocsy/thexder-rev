<ui:FluentWindow
    x:Class="Thexder.UI.ControlsWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Thexder Controls"
    Width="800"
    Height="730"
    FontSize="12"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Grid Background="#080B18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitle" Height="32" Title="Thexder Controls" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Width="16" Height="16" Source="pack://application:,,,/Include/Thexder.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Header: title, the layout in use, and in remap mode the templates -->
        <Grid Grid.Row="1" Height="92">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#0E1638" />
                    <GradientStop Offset="0.6" Color="#0A0F26" />
                    <GradientStop Offset="1" Color="#1A0C18" />
                </LinearGradientBrush>
            </Grid.Background>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.92,0.2" GradientOrigin="0.92,0.2" RadiusX="0.35" RadiusY="1.4">
                        <GradientStop Offset="0" Color="#38E8463A" />
                        <GradientStop Offset="1" Color="#00E8463A" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel Margin="28,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Heading" FontFamily="Bahnschrift, Segoe UI" FontSize="26" FontWeight="Bold" Foreground="#EEF1F8">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="18" Opacity="0.55" ShadowDepth="0" Color="#E8463A" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="Subheading" Margin="2,2,0,0" FontSize="12.5" Foreground="#4FD8FF" />
            </StackPanel>
            <StackPanel x:Name="Templates" Margin="0,0,24,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" />
            <Rectangle Height="1" VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#00E8463A" />
                        <GradientStop Offset="0.35" Color="#E8463A" />
                        <GradientStop Offset="0.75" Color="#4FD8FF" />
                        <GradientStop Offset="1" Color="#004FD8FF" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- The cards, built by the code-behind -->
        <Grid x:Name="Body" Grid.Row="2" Margin="20,14,20,6" />

        <!-- Status or tips, and the buttons -->
        <Grid Grid.Row="3" Margin="24,6,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="11.5" Foreground="#8F98AE" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button x:Name="RemapButton" MinWidth="110" Margin="0,0,8,0" Content="Remap Keys..." Click="OnRemap" />
                <ui:Button x:Name="SaveButton" MinWidth="90" Margin="0,0,8,0" Appearance="Primary" Content="Save" Click="OnSave"
                           Background="#E8463A" MouseOverBackground="#F25D4F" PressedBackground="#C23A30" Foreground="White" BorderBrush="Transparent" />
                <ui:Button x:Name="CloseButton" MinWidth="90" Content="Close" IsCancel="True" Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
