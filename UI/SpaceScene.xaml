<UserControl
    x:Class="Thexder.UI.SpaceScene"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ClipToBounds="True"
    IsHitTestVisible="False">
    <!-- Deep space, a planet, stars and a grid floor that Thexder runs on; laid out by the code-behind for any size. -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#0B1233" />
                <GradientStop Offset="0.7" Color="#060A1C" />
                <GradientStop Offset="1" Color="#03040B" />
            </LinearGradientBrush>
        </Grid.Background>

        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.8,0.16" GradientOrigin="0.8,0.16" RadiusX="0.47" RadiusY="0.96">
                    <GradientStop Offset="0" Color="#40E8463A" />
                    <GradientStop Offset="1" Color="#00E8463A" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.2,0.8" GradientOrigin="0.2,0.8" RadiusX="0.37" RadiusY="0.64">
                    <GradientStop Offset="0" Color="#264FD8FF" />
                    <GradientStop Offset="1" Color="#004FD8FF" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Canvas>
            <Ellipse x:Name="Planet" StrokeThickness="2" CacheMode="BitmapCache">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.35,0.9" GradientOrigin="0.3,0.95" RadiusX="0.75" RadiusY="0.75">
                        <GradientStop Offset="0" Color="#5A2A2A" />
                        <GradientStop Offset="0.45" Color="#2A1528" />
                        <GradientStop Offset="1" Color="#0B0C1E" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0.2,1" EndPoint="0.8,0">
                        <GradientStop Offset="0" Color="#CCFF7A5C" />
                        <GradientStop Offset="0.5" Color="#33E8463A" />
                        <GradientStop Offset="1" Color="#00E8463A" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="40" Opacity="0.55" ShadowDepth="0" Color="#E8463A" />
                </Ellipse.Effect>
            </Ellipse>

            <Path x:Name="StarsFar" Opacity="0.35" Stroke="#C8D2FF" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path x:Name="StarsMid" Opacity="0.6" Stroke="#E4E9FF" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path x:Name="StarsNear" Opacity="0.9" Stroke="White" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

            <Rectangle x:Name="FloorTint">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#00E8463A" />
                        <GradientStop Offset="1" Color="#1FE8463A" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Path x:Name="GridLines" Stroke="#E8463A" StrokeThickness="1" />
            <Rectangle x:Name="HorizonLine" Height="2" CacheMode="BitmapCache">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#00E8463A" />
                        <GradientStop Offset="0.55" Color="#E0FF6A50" />
                        <GradientStop Offset="1" Color="#30E8463A" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.Effect>
                    <DropShadowEffect BlurRadius="14" Opacity="0.9" ShadowDepth="0" Color="#E8463A" />
                </Rectangle.Effect>
            </Rectangle>

            <Ellipse x:Name="Shadow">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#B0000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Line x:Name="Laser" Stroke="#4FD8FF" StrokeThickness="2" Visibility="Hidden">
                <Line.Effect>
                    <DropShadowEffect BlurRadius="12" Opacity="1" ShadowDepth="0" Color="#4FD8FF" />
                </Line.Effect>
            </Line>
            <Image x:Name="Robot" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" />
        </Canvas>
    </Grid>
</UserControl>
