<ui:FluentWindow
    x:Class="Thexder.UI.PanelWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="232"
    Height="210"
    MinWidth="120"
    MinHeight="80"
    FontSize="12"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="DoNotRound"
    ShowInTaskbar="False"
    ShowActivated="False"
    WindowStartupLocation="Manual">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Height="28" ShowMaximize="False" ShowMinimize="False" />

        <Border Grid.Row="1" Background="Black">
            <Image x:Name="Picture" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"
                   MouseLeftButtonDown="OnMouseLeft" MouseRightButtonDown="OnMouseRight" />
        </Border>
    </Grid>
</ui:FluentWindow>
