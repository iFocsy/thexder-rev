<Application
    x:Class="Thexder.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Compact density (as qemu-mon). WPF-UI reads these keys through DynamicResource, so overriding them
                 here resizes every text box, combo box and list. -->
            <sys:Double x:Key="ControlContentThemeFontSize">12</sys:Double>
            <Thickness x:Key="TextControlThemePadding">6,3,6,3</Thickness>
            <sys:Double x:Key="TextControlThemeMinHeight">24</sys:Double>
            <Thickness x:Key="ComboBoxPadding">8,2,8,2</Thickness>
            <sys:Double x:Key="ListViewItemMinHeight">24</sys:Double>

            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

            <!-- Button padding is a StaticResource inside WPF-UI, so it is set by style. The bases are WPF-UI's named
                 styles: a style keyed by its own type would find itself. -->
            <Style BasedOn="{StaticResource DefaultUiButtonStyle}" TargetType="{x:Type ui:Button}">
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="MinHeight" Value="24" />
            </Style>
            <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="{x:Type Button}">
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="MinHeight" Value="24" />
            </Style>
            <Style BasedOn="{StaticResource DefaultCheckBoxStyle}" TargetType="{x:Type CheckBox}">
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="MinWidth" Value="0" />
            </Style>
            <Style BasedOn="{StaticResource DefaultRadioButtonStyle}" TargetType="{x:Type RadioButton}">
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="MinWidth" Value="0" />
            </Style>

            <!-- Card frame for the dialogs. -->
            <Style x:Key="Frame" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <!-- Compact choice lists in the dialogs: 12-point rows, a subtle fill on hover and selection and the
                 Fluent accent bar on the selected row. -->
            <Style x:Key="CompactList" TargetType="{x:Type ListBox}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBox}">
                            <Border Style="{StaticResource Frame}" CornerRadius="6" Padding="3">
                                <ScrollViewer Focusable="False" Padding="0">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CompactListItem" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Padding" Value="12,5,10,5" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Grid Background="Transparent">
                                <Border x:Name="Back" CornerRadius="4" Background="Transparent" />
                                <Rectangle x:Name="Bar" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left"
                                           Margin="1,0,0,0" Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Secondary" TargetType="{x:Type TextBlock}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
